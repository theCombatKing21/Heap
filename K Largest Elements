public static void firstKElements(int arr[], int n, int k)
{
	
	PriorityQueue<Integer> minHeap = new PriorityQueue<>();
	for(int i = 0; i < k; i++)
	{
		minHeap.add(arr[i]);  //add all elements into min Heap for first k items
	}
	for(int i = k; i < n; i++)
	{
		if (minHeap.peek() > arr[i])  // add other elements after k one by one based on logic
			continue;
		else
		{
			minHeap.poll();
			minHeap.add(arr[i]);
		}
	}
	
	Iterator iterator = minHeap.iterator(); 
	
	while (iterator.hasNext()) 
	{ 
		System.out.print(iterator.next() + " "); //print all heap elements
	} 
}
